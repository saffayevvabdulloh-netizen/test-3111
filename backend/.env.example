# ---- Django ----
DEBUG=True
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=
# Where the built React app lives (default: ../frontend/dist)
# FRONTEND_DIST=
# Serve /media from Django (ok for one small server)
SERVE_MEDIA=True
# Set False ONLY if you run DEBUG=False over plain http (local test). Keep True behind HTTPS.
# SECURE_COOKIES=False

# ---- Database ----
# Default is SQLite. For PostgreSQL (e.g. docker compose) use:
# DATABASE_URL=postgres://admin:123456@db:5432/school_db
DATABASE_URL=sqlite:///db.sqlite3

# ---- Telegram verification ----
# Token from @BotFather. NEVER commit a real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TG_CODE_Verification_bot
# Start the bot together with `manage.py runserver` (dev convenience)
RUN_TELEGRAM_BOT=True
# False -> accounts are active right after register (local dev without Telegram)
REQUIRE_TELEGRAM_VERIFICATION=True

# ---- Throttling (DRF format) ----
THROTTLE_AUTH=20/min
THROTTLE_JOIN=30/hour

# Rate limits (per IP). Login / code endpoints are strict; sign-up is roomier so a school or clinic can register many children.
# THROTTLE_AUTH=20/min
# THROTTLE_REGISTER=120/hour

# ---- Text-to-speech (ElevenLabs, voice "Adam") ----
# Get a key at https://elevenlabs.io (Profile -> API Keys). NEVER commit a real key and NEVER put it in the frontend.
# Default voice = Microsoft "Madina" (real Uzbek, free, no key). Use Adam instead: TTS_PROVIDER=elevenlabs + the key below.
# TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
# Optional overrides (defaults: Adam + eleven_multilingual_v2):
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_MAX_CHARS=500
# THROTTLE_TTS=40/min

# Sign-up is CLOSED by default: the administrator opens accounts (/admin/ or `manage.py import_users`). True = anybody can sign up.
# ALLOW_REGISTRATION=False

# Behind HTTPS (nginx / platform proxy): redirect to https + HSTS
# HTTPS_ONLY=True
# Several workers / servers: shared cache for rate limits
# REDIS_URL=redis://redis:6379/1
# WEB_CONCURRENCY=2
# WEB_THREADS=8

# ---- Xavfsizlik va qonunchilik (docs/UZ_HUQUQIY_TALABLAR.md) ----
# ADMIN_URL=boshqaruv-maxfiy/        # admin paneli manzili (oxirida /)
# NUM_PROXIES=1                      # nginx/proksi ortida 1; to'g'ridan-to'g'ri 0
# CONSENT_VERSION=2026-11            # o'zgarsa hamma qayta rozilik beradi
# AGE_LABEL=0+
# LEGAL_OPERATOR=
# LEGAL_TIN=
# LEGAL_ADDRESS=
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_DATA_LOCATION=Toshkent, O'zbekiston
# LEGAL_REGISTER_NUMBER=             # davlat reestri guvohnomasi raqami
# CHAT_RETENTION_DAYS=365
# AUDIT_RETENTION_DAYS=365
# MOOD_RETENTION_DAYS=730
# TTS_ALLOWLIST_ONLY=True            # ovoz xizmatiga faqat tayyor jumlalar
# Kunlik cron: python manage.py purge_old_data

# Birinchi admin (hisob yo'q bo'lsa o'zi yaratiladi). Parol bo'sh bo'lsa tasodifiy parol konsolga chiqadi.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
