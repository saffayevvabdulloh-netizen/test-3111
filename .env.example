# Used by docker-compose (copy to .env). For local non-docker runs use backend/.env instead.

# --- required ---
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me            # avoid characters like @ : / # in this password (it goes into a URL)
TELEGRAM_BOT_TOKEN=                    # NEW token from @BotFather (revoke the old leaked one!)
TELEGRAM_BOT_USERNAME=TG_CODE_Verification_bot

# --- your domain ---
ALLOWED_HOSTS=localhost,127.0.0.1      # e.g. zumrad.example.com
CSRF_TRUSTED_ORIGINS=                  # e.g. https://zumrad.example.com
# Behind HTTPS keep this True. Use False only for a plain-http test on your own machine.
SECURE_COOKIES=False

# --- optional ---
PORT=8000
POSTGRES_DB=zumrad
POSTGRES_USER=zumrad
REQUIRE_TELEGRAM_VERIFICATION=True

# ---- Text-to-speech (ElevenLabs, voice "Adam") ----
# Get a key at https://elevenlabs.io (Profile -> API Keys). NEVER commit a real key and NEVER put it in the frontend.
# Default voice = Microsoft "Madina" (real Uzbek, free, no key). Use Adam instead: TTS_PROVIDER=elevenlabs + the key below.
# TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
# Optional overrides (defaults: Adam + eleven_multilingual_v2):
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_MAX_CHARS=500
# THROTTLE_TTS=40/min
